---
import { ROUTES, NAVIGATION, FOOTER_LINKS, FOOTER_PRODUCT } from '@/utils/routes';
import AuthMenu from '@/components/AuthMenu.astro';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/clay.css';
import '@/styles/glass.css';
import '@/styles/motion.css';
import '@/styles/creator-part1.css';
import '@/styles/creator-part2.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Create beautiful, personalized birthday experiences with wishes, photos, and themes.',
  ogImage = '/images/og-default.svg',
  ogType = 'website',
} = Astro.props;

const fullTitle = title === 'Home' ? 'BirthdayWish - Make Their Birthday Feel Like a Little World' : `${title} | BirthdayWish`;
const siteUrl = Astro.url?.origin ?? 'https://birthday-platform.example.com';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url?.href ?? siteUrl} />
<meta property="og:image" content={`${siteUrl}${ogImage}`} />
<meta property="og:site_name" content="BirthdayWish" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
<meta name="theme-color" content="#A02F60" />
<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
<title>{fullTitle}</title>
<style is:inline>
body { visibility: hidden; }
body.styles-ready { visibility: visible; }
</style>
<noscript><style>body { visibility: visible !important; }</style></noscript>
</head>

<body>
<a href="#main-content" class="skip-link">Skip to main content</a>

<div id="announcement-bar" class="announcement-bar">
<div class="container-page flex items-center justify-center" style="padding-top: var(--space-2); padding-bottom: var(--space-2);">
<p class="text-xs font-medium text-center" style="margin: 0;">
Demo prototype — no real accounts, payments, or uploads.
<a href={ROUTES.PRICING}>See plans</a>
</p>
<button type="button" id="dismiss-announcement" aria-label="Dismiss announcement" style="position: absolute; right: var(--space-4); top: 50%; transform: translateY(-50%); color: rgba(250,247,242,0.7); cursor: pointer; padding: var(--space-1);">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
</button>
</div>
</div>

<header class="glass-nav">
<nav class="container-page flex items-center justify-between" aria-label="Main navigation">
<a href={ROUTES.HOME} class="brand" aria-label="BirthdayWish home">
<span class="brand-mark" aria-hidden="true">
<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3c0 4.7 3.6 8.3 8.3 8.3v1.4C15.6 12.7 12 16.3 12 21c0-4.7-3.6-8.3-8.3-8.3v-1.4C8.4 11.3 12 7.7 12 3z"/><path d="M19.2 3.2c0 1.5-.6 2.1-2.1 2.1 1.5 0 2.1.6 2.1 2.1 0-1.5.6-2.1 2.1-2.1-1.5 0-2.1-.6-2.1-2.1z"/></svg>
</span>
<span class="brand-word hidden sm:inline">BirthdayWish<span class="brand-dot">.</span></span>
</a>
<ul class="hidden items-center gap-1 md:flex" role="list">
{NAVIGATION.map((item) => (
<li><a href={item.href} class="nav-link">{item.label}</a></li>
))}
</ul>
<div class="flex items-center gap-2">
<AuthMenu />
<a href={ROUTES.CREATE} class="clay-btn clay-btn-primary clay-btn-sm">Create a page</a>
<button type="button" class="clay-icon-btn clay-icon-btn-sm md:hidden" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
</button>
</div>
</nav>
<div id="mobile-menu" class="hidden md:hidden" style="border-top: 1px solid var(--color-border); background: var(--color-surface);">
<div class="container-page py-4">
<ul class="space-y-1" role="list">
{NAVIGATION.map((item) => (
<li><a href={item.href} class="nav-link" style="display: block;">{item.label}</a></li>
))}
<li class="pt-2"><a href={ROUTES.CREATE} class="clay-btn clay-btn-primary clay-btn-full">Create a Birthday Surprise</a></li>
</ul>
</div>
</div>
</header>

<main id="main-content">
<slot />
</main>









<footer class="site-footer">
<div class="container-page">
<div class="footer-grid">
<div>
<a href={ROUTES.HOME} class="brand footer-brand" aria-label="BirthdayWish home">
<span class="brand-mark" aria-hidden="true">
<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3c0 4.7 3.6 8.3 8.3 8.3v1.4C15.6 12.7 12 16.3 12 21c0-4.7-3.6-8.3-8.3-8.3v-1.4C8.4 11.3 12 7.7 12 3z"/></svg>
</span>
<span class="brand-word">BirthdayWish<span class="brand-dot">.</span></span>
</a>
<p class="footer-brand-copy">
Personal birthday pages with heartfelt messages, photos, and playful themes — always previewed before you share.
</p>
<p class="footer-note">Demo prototype. Drafts stay in this browser.</p>
</div>
<div>
<h3 class="footer-heading">Product</h3>
<ul class="space-y-3" role="list">
{FOOTER_PRODUCT.map((item) => (
<li><a href={item.href} class="footer-link">{item.label}</a></li>
))}
</ul>
</div>
<div>
<h3 class="footer-heading">Company</h3>
<ul class="space-y-3" role="list">
{FOOTER_LINKS.map((item) => (
<li><a href={item.href} class="footer-link">{item.label}</a></li>
))}
</ul>
</div>
</div>
<div class="footer-bottom">
<p style="margin: 0;">&copy; {new Date().getFullYear()} BirthdayWish. Demo prototype — not a real service.</p>
<p style="margin: 0;">Made with care · Previewed with love</p>
</div>
</div>
</footer>

<script>
const menuBtn = document.getElementById('mobile-menu-btn');
const mobileMenu = document.getElementById('mobile-menu');
if (menuBtn && mobileMenu) {
menuBtn.addEventListener('click', () => {
const isOpen = !mobileMenu.classList.contains('hidden');
mobileMenu.classList.toggle('hidden');
menuBtn.setAttribute('aria-expanded', String(!isOpen));
menuBtn.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
});
}
const dismissBtn = document.getElementById('dismiss-announcement');
const announcement = document.getElementById('announcement-bar');
if (dismissBtn && announcement) {
dismissBtn.addEventListener('click', () => {
announcement.style.display = 'none';
try { localStorage.setItem('bw-announcement-dismissed', '1'); } catch (e) {}
});
try {
if (localStorage.getItem('bw-announcement-dismissed') === '1') {
announcement.style.display = 'none';
}
} catch (e) {}
}
document.body.classList.add('styles-ready');
</script>
</body>
</html>








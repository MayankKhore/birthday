---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES } from '@/utils/routes';
import { PLAN_COMPARISONS } from '@/lib/subscriptions/PlanComparisons';
---

<BaseLayout title="Pricing" description="Choose the plan that works for you. Free and Premium options available.">
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-heading-xl font-extrabold text-neutral-900 dark:text-neutral-50">
          Simple, Transparent Pricing
        </h1>
        <p class="mt-4 text-body-lg text-neutral-600 dark:text-neutral-300">
          Start free. Upgrade when you need more. No hidden fees, no surprises.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-4xl gap-8 sm:grid-cols-2">
        {PLAN_COMPARISONS.map((plan) => (
          <div class={`card p-8 ${plan.highlight ? 'ring-2 ring-brand-500' : ''}`}>
            {plan.highlight && (
              <p class="badge badge-primary mb-4">Most Popular</p>
            )}
            <h2 class="text-heading-md font-bold text-neutral-900 dark:text-neutral-50">{plan.name}</h2>
            <div class="mt-4 flex items-baseline gap-1">
              <span class="text-display-sm font-extrabold text-neutral-900 dark:text-neutral-50">{plan.price}</span>
              <span class="text-neutral-600 dark:text-neutral-400">/ {plan.priceNote}</span>
            </div>
            <ul class="mt-6 space-y-3" role="list">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3">
                  {feature.included ? (
                    <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-success" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  ) : (
                    <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-neutral-300 dark:text-neutral-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  )}
                  <span class={feature.included ? 'text-neutral-700 dark:text-neutral-300' : 'text-neutral-400 dark:text-neutral-500'}>
                    {feature.text}
                  </span>
                </li>
              ))}
            </ul>
            <a
              href={ROUTES.CREATE}
              class={`btn mt-8 w-full ${plan.highlight ? 'btn-primary' : 'btn-secondary'}`}
            >
              {plan.cta}
            </a>
          </div>
        ))}
      </div>

      <div class="mx-auto mt-12 max-w-2xl text-center">
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          All prices in USD. Premium is a simulated tier for demo purposes &mdash; no actual payment is processed.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
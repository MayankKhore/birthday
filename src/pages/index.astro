<script>
(function () {
  var backdrop = document.getElementById('theme-dialog-backdrop');
  var dialog = document.getElementById('theme-dialog');
  var titleEl = document.getElementById('theme-dialog-title');
  var artEl = document.getElementById('theme-dialog-art');
  var copyEl = document.getElementById('theme-dialog-copy');
  var closeBtn = document.getElementById('theme-dialog-close');
  var backBtn = document.getElementById('theme-dialog-back');
  var lastFocus = null;
  var THEMES = {
    'lavender-parade': {
      name: 'Lavender Parade',
      bg: 'linear-gradient(160deg, #EDEBFA 0%, #DFD8F3 45%, #F3C5D7 130%)',
      ink: '#201C38',
      emoji: '🎈',
      tag: 'HAPPY BIRTHDAY, JULES',
      headline: 'Confetti looks good on you',
      copy: 'Lavender Parade opens with a soft violet sky, floating confetti, and a message card that glows like candlelight. Best for joyful, gentle surprises — best friends, siblings, anyone who laughs easily.'
    },
    'peach-morning': {
      name: 'Peach Morning',
      bg: 'linear-gradient(160deg, #FFF3E0 0%, #FFC9B8 55%, #FFA88F 130%)',
      ink: '#4A2418',
      emoji: '🌅',
      tag: 'HAPPY BIRTHDAY, PRIYA',
      headline: 'A sunrise made just for you',
      copy: 'Peach Morning feels like breakfast in bed: warm peach gradients, a golden message card, and sun-soft photo frames. Best for partners, parents, and golden-hearted people.'
    },
    'mint-meadow': {
      name: 'Mint Meadow',
      bg: 'linear-gradient(160deg, #EAF6EF 0%, #C7E8D2 55%, #9FD6B4 130%)',
      ink: '#173A2B',
      emoji: '🌿',
      tag: 'HAPPY BIRTHDAY, THEO',
      headline: 'Fresh air, fresh year',
      copy: 'Mint Meadow is calm and outdoorsy — meadow greens, breathing space, and crisp white cards. Best for colleagues, mentors, and anyone who loves the quiet kind of celebration.'
    },
    'midnight-toast': {
      name: 'Midnight Toast',
      bg: 'linear-gradient(160deg, #2B2452 0%, #201C38 55%, #100E38 130%)',
      ink: '#FFF9F0',
      emoji: '🌙',
      tag: 'HAPPY BIRTHDAY, NOOR',
      headline: 'Raise a glass to the stars',
      copy: 'Midnight Toast is candlelight and constellations: deep navy, starlight gold, and a message that glows after dark. Best for milestone birthdays and dramatic romantics.'
    }
  };
  function openTheme(id, trigger) {
    var t = THEMES[id];
    if (!t || !backdrop) return;
    lastFocus = trigger || document.activeElement;
    if (titleEl) titleEl.textContent = t.name + ' — preview';
    if (artEl) {
      artEl.style.background = t.bg;
      artEl.innerHTML = '<div style="font-size: 2.25rem; margin-bottom: var(--space-3);">' + t.emoji + '</div>'
        + '<p class="text-xs font-semibold" style="letter-spacing: var(--tracking-widest); color: ' + t.ink + '; opacity: 0.75; margin-bottom: var(--space-2);">' + t.tag + '</p>'
        + '<p class="font-display text-2xl font-bold" style="color: ' + t.ink + ';">' + t.headline + '</p>';
    }
    if (copyEl) copyEl.textContent = t.copy;
    backdrop.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    if (closeBtn) closeBtn.focus();
  }
  function closeTheme() {
    if (!backdrop) return;
    backdrop.classList.add('hidden');
    document.body.style.overflow = '';
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }
  document.querySelectorAll('.theme-preview-btn').forEach(function (btn) {
    btn.addEventListener('click', function () { openTheme(btn.getAttribute('data-theme'), btn); });
  });
  if (closeBtn) closeBtn.addEventListener('click', closeTheme);
  if (backBtn) backBtn.addEventListener('click', closeTheme);
  if (backdrop) backdrop.addEventListener('click', function (e) { if (e.target === backdrop) closeTheme(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && backdrop && !backdrop.classList.contains('hidden')) closeTheme();
  });
})();
</script>

<style>
  /*
   * The dialog backdrop is centered with flexbox while open, and hidden via
   * the .hidden class. The ID+class selector (specificity 1,1,0) beats both
   * the ID-only rule above and Tailwind's .hidden, so closing always wins —
   * an inline `display: flex` here would have overridden the class entirely
   * and made the close button appear broken.
   */
  #theme-dialog-backdrop {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #theme-dialog-backdrop.hidden {
    display: none;
  }

  /* Guard for any attribute-based hiding on this page. */
  [hidden] {
    display: none !important;
  }
</style>
---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES } from '@/utils/routes';
---

<BaseLayout title="How It Works" description="Learn how to create a beautiful birthday experience in 3 easy steps.">
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-heading-xl font-extrabold text-neutral-900 dark:text-neutral-50">
          How It Works
        </h1>
        <p class="mt-4 text-body-lg text-neutral-600 dark:text-neutral-300">
          Creating a memorable birthday experience takes just a few minutes.
        </p>
      </div>

      <div class="mx-auto mt-16 max-w-3xl space-y-12">
        <!-- Step 1 -->
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 text-xl font-bold text-brand-600 dark:bg-brand-900 dark:text-brand-400">
            1
          </div>
          <div>
            <h2 class="text-heading-sm font-bold text-neutral-900 dark:text-neutral-50">Enter Their Details</h2>
            <p class="mt-2 text-neutral-600 dark:text-neutral-300">
              Add the birthday person's name, age, and your relationship. Choose the
              occasion type and pick a theme that matches their personality.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-accent-100 text-xl font-bold text-accent-600 dark:bg-accent-900 dark:text-accent-400">
            2
          </div>
          <div>
            <h2 class="text-heading-sm font-bold text-neutral-900 dark:text-neutral-50">Write or Choose a Wish</h2>
            <p class="mt-2 text-neutral-600 dark:text-neutral-300">
              Select from our original message templates or write your own heartfelt
              wish. Add your favorite photos to make it even more personal.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 text-xl font-bold text-brand-600 dark:bg-brand-900 dark:text-brand-400">
            3
          </div>
          <div>
            <h2 class="text-heading-sm font-bold text-neutral-900 dark:text-neutral-50">Preview and Share</h2>
            <p class="mt-2 text-neutral-600 dark:text-neutral-300">
              Preview the full experience, make any final tweaks, then publish and
              share the link. That is it &mdash; their special day just got better.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-16 text-center">
        <a href={ROUTES.CREATE} class="btn btn-primary btn-lg">
          Get Started Now
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
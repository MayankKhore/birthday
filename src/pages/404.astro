---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES } from '@/utils/routes';
---

<BaseLayout title="Page Not Found" description="The page you are looking for does not exist.">
  <section class="flex min-h-[60vh] items-center justify-center py-20">
    <div class="container mx-auto px-4 text-center">
      <p class="text-7xl font-extrabold text-brand-600 dark:text-brand-400">404</p>
      <h1 class="mt-4 text-heading-lg font-bold text-neutral-900 dark:text-neutral-50">
        Page Not Found
      </h1>
      <p class="mx-auto mt-4 max-w-md text-neutral-600 dark:text-neutral-300">
        Sorry, we could not find the page you are looking for. It may have been moved or no longer exists.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={ROUTES.HOME} class="btn btn-primary">
          Go Home
        </a>
        <a href={ROUTES.CREATE} class="btn btn-secondary">
          Create a Birthday Wish
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
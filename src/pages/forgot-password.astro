---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES } from '@/utils/routes';
---

<BaseLayout title="Forgot Password" description="Demo password-reset explanation — no real email is sent and no password exists.">
<section class="section ambient-bg">
<div class="container-page" style="position: relative; z-index: 1;">
<div class="mx-auto" style="max-width: 480px;">
<div class="clay-card-static p-8">
<div class="text-center" style="margin-bottom: var(--space-6);">
<span class="clay-badge clay-badge-primary" style="margin-bottom: var(--space-4);">Demo only</span>
<h1 class="text-display" style="font-size: var(--text-3xl); margin-bottom: var(--space-2);">No password to reset</h1>
<p class="text-sm" style="color: var(--color-text-secondary);">Demo sessions use email only. There is no password to recover and no reset email is ever sent.</p>
</div>
<div id="reset-success" class="hidden" role="status" style="margin-bottom: var(--space-4); padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg); background: var(--color-success-light); color: var(--color-success-dark); font-size: var(--text-sm);"></div>
<div id="reset-error" class="hidden" role="alert" tabindex="-1" style="margin-bottom: var(--space-4); padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg); background: var(--color-error-light); color: var(--color-error-dark); font-size: var(--text-sm);"></div>
<form id="reset-form" novalidate aria-label="Demo reset demonstration form">
<div style="margin-bottom: var(--space-6);">
<label class="clay-label" for="reset-email">Email</label>
<input class="clay-input" type="email" id="reset-email" name="email" required autocomplete="email" placeholder="you@example.com" />
<span class="clay-help">Enter the demo email you used. We will only acknowledge it on screen.</span>
</div>
<button type="submit" id="reset-submit" class="clay-btn clay-btn-primary clay-btn-full clay-btn-lg">Show demo acknowledgement</button>
</form>
<p class="text-sm text-center" style="color: var(--color-text-secondary); margin-top: var(--space-6);">
Remember this is a demo? <a href={ROUTES.LOGIN}>Back to sign in</a>
</p>
</div>
</div>
</div>
</section>
</BaseLayout>

<script>
(function () {
var form = document.getElementById('reset-form');
var emailEl = document.getElementById('reset-email');
var submitBtn = document.getElementById('reset-submit');
var errorBox = document.getElementById('reset-error');
var successBox = document.getElementById('reset-success');
var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
function showError(msg) {
if (successBox) { successBox.textContent = ''; successBox.classList.add('hidden'); }
if (!errorBox) return;
errorBox.textContent = msg;
errorBox.classList.remove('hidden');
errorBox.focus();
}
function showSuccess(msg) {
if (errorBox) { errorBox.textContent = ''; errorBox.classList.add('hidden'); }
if (!successBox) return;
successBox.textContent = msg;
successBox.classList.remove('hidden');
successBox.focus();
}
if (form) {
form.addEventListener('submit', function (e) {
e.preventDefault();
var email = emailEl ? emailEl.value.trim().toLowerCase() : '';
if (!EMAIL_RE.test(email)) {
showError('Enter a valid email address first.');
if (emailEl) emailEl.focus();
return;
}
if (submitBtn) { submitBtn.disabled = true; submitBtn.classList.add('clay-btn-loading'); submitBtn.textContent = 'Checking…'; }
window.setTimeout(function () {
if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('clay-btn-loading'); submitBtn.textContent = 'Show demo acknowledgement'; }
showSuccess('Demo acknowledged for ' + email + '. No email was sent, because demo accounts have no passwords.');
}, 300);
});
}
})();
</script>
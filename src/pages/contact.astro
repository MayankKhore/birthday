---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES } from '@/utils/routes';
---

<BaseLayout title="Contact" description="Contact BirthdayWish — send feedback or ask a question. Demo form only.">
  <section class="section">
    <div class="container-page">
      <div class="mx-auto" style="max-width: 560px;">
        <div class="text-center" style="margin-bottom: var(--space-10);">
          <span class="clay-badge clay-badge-primary">Contact</span>
          <h1 class="text-display" style="font-size: clamp(2.25rem, 5vw, 3.5rem); margin: var(--space-4) 0 var(--space-4);">Say hello</h1>
          <p class="text-body">This is a demo contact form — messages stay in your browser and are not sent anywhere.</p>
        </div>
        <form class="clay-card-static p-8" onsubmit="return false;" aria-label="Demo contact form">
          <div style="margin-bottom: var(--space-5);">
            <label class="clay-label" for="contact-name">Your name</label>
            <input class="clay-input" type="text" id="contact-name" name="name" placeholder="e.g. Sam" autocomplete="name" />
          </div>
          <div style="margin-bottom: var(--space-5);">
            <label class="clay-label" for="contact-email">Email</label>
            <input class="clay-input" type="email" id="contact-email" name="email" placeholder="you@example.com" autocomplete="email" />
          </div>
          <div style="margin-bottom: var(--space-6);">
            <label class="clay-label" for="contact-message">Message</label>
            <textarea class="clay-textarea" id="contact-message" name="message" placeholder="What would you like to tell us?"></textarea>
          </div>
          <button class="clay-btn clay-btn-primary clay-btn-full" type="submit">Send message (demo)</button>
          <p class="text-xs text-center" style="color: var(--color-text-tertiary); margin-top: var(--space-4);">Prefer browsing? <a href={ROUTES.FAQ}>Read the FAQ</a> instead.</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>